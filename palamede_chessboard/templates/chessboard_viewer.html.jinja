<!doctype html>
<html lang="fr"><head>
<meta charset="utf-8">
<title>Chess Viewer</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/chessground@9.2.1/assets/chessground.base.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/chessground@9.2.1/assets/chessground.brown.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/chessground@9.2.1/assets/chessground.cburnett.css">
<style>
{% include "viewer/_styles.css.jinja" %}
</style>
</head><body>
<div class="wrap">
  <div class="header" id="hdr">
    <div>
      <label style="font-size:11px;color:var(--text-muted);margin-right:6px;">game:</label>
      <span class="gsel" id="gsel">
        <input type="text" id="gameid" class="gameid-input" placeholder="game_id ou recherche" autocomplete="off"
               role="combobox" aria-expanded="false" aria-controls="gsel-panel" />
        <div class="gsel-panel" id="gsel-panel" role="listbox" hidden>
          <label class="gsel-opt"><input type="checkbox" id="gsel-exos" checked /> exercices terminés</label>
          <div class="gsel-sec">En cours</div>
          <div id="gsel-live"></div>
          <div class="gsel-sec">Terminées récemment</div>
          <div id="gsel-done"></div>
          <button type="button" class="gsel-more" id="gsel-more" hidden>Plus anciennes…</button>
        </div>
      </span>
      <select id="role" class="role-select">
        {% for v in viewer_roles -%}
        <option value="{{ v }}">{{ v }}</option>
        {% endfor -%}
      </select>
    </div>
    <div id="hdr-meta" style="font-family: ui-monospace, monospace; font-size: 12px; color: var(--text-muted);">—</div>
  </div>
  <div class="layout">
    <div>
      <div id="board"><div id="move-error"></div></div>
      <div class="clocks" id="clocks" style="display:none">
        <div class="clock" id="clock-white"><div class="label">Blancs</div><div class="time" id="time-white">—</div></div>
        <div class="clock" id="clock-black"><div class="label">Noirs</div><div class="time" id="time-black">—</div></div>
      </div>
      <div class="controls">
        <button onclick="g('s')" title="Début (Home)">⏮</button>
        <button onclick="g('p')" title="Précédent (←)">◀</button>
        <span class="ct" id="ct">0 / 0</span>
        <button onclick="g('n')" title="Suivant (→)">▶</button>
        <button onclick="g('e')" title="Fin (End)">⏭</button>
      </div>
      <div class="status">
        <span class="live"><span class="pulse" id="pulse"></span><span id="liveStatus">Connexion…</span></span>
        <span id="trait"></span>
      </div>
    </div>
    <div>
      <div class="moves" id="moves"></div>
      <div class="engine" id="engine">
        <h3>
          Analyse Stockfish
          <label style="float:right;font-weight:normal;text-transform:none;letter-spacing:0;font-size:11px;">
            Depth
            <select id="engineDepth" style="font-size:11px;padding:1px 4px;margin-left:4px;">
              {% for d in depth_options -%}
              <option value="{{ d }}"{% if d == default_depth %} selected{% endif %}>{{ d }}</option>
              {% endfor -%}
            </select>
          </label>
        </h3>
        <div class="empty">—</div>
      </div>
      <div class="commentary" id="commentary"><h3>Commentaires</h3><div class="empty">Aucun commentaire pour ce coup.</div></div>
      <div class="captures" id="captures"><h3>Matériel capturé</h3><div class="empty">Position initiale — rien capturé.</div></div>
      <div class="elo-board" id="elo-board"><h3><span>Classement Elo</span><span class="source" id="elo-source"></span></h3><div class="empty">Chargement…</div></div>
    </div>
  </div>
</div>
<script>
{% include "viewer/_state.js.jinja" %}
{% include "viewer/_games_list.js.jinja" %}
{% include "viewer/_poll.js.jinja" %}
{% include "viewer/_render.js.jinja" %}
{% include "viewer/_live.js.jinja" %}
</script>
<script type="module">
{% include "viewer/_board.js.jinja" %}
</script>
</body></html>
