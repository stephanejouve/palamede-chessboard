// Chessground : drag&drop board (lichess). ESM module embedded in the
// package and served by the viewer itself (issue #59 : no third-party
// script on a page that holds the player token). Falls back gracefully to
// the static SVG board (via /api/board.svg) if the import fails : window.__cgSetFen
// stays undefined and draw() no-ops, but the moves list, clocks,
// commentary and engine panel keep working.
import { Chessground } from '/vendor/chessground@{{ chessground_version }}/chessground.min.js';

const boardEl = document.getElementById('board');
const errorEl = document.getElementById('move-error');
// Chessground removes children on init, so re-parent the error overlay.
if (errorEl && errorEl.parentNode === boardEl) boardEl.removeChild(errorEl);
boardEl.classList.add('cg-wrap');

let cg = null;
let cgFenSnapshot = null;  // FEN before the last user drop, for revert on 422.

function showMoveError(msg) {
  if (!errorEl) return;
  errorEl.textContent = msg;
  errorEl.classList.add('show');
  setTimeout(() => errorEl.classList.remove('show'), 2500);
}

async function onUserDrop(from, to) {
  const gid = window.gameId();  // the displayed game, not the search box (#46)
  if (!gid) return;
  // Promotion : chessground doesn't ship a dialog by default. We send
  // the drop as UCI ; if it's a pawn reaching the last rank, we append
  // 'q' server-side (implicit queen promotion, most common case).
  let uci = from + to;
  const piece = cg ? cg.state.pieces.get(to) : null;
  const isPromoRank = (piece && piece.role === 'pawn' &&
    (to.endsWith('8') || to.endsWith('1')));
  if (isPromoRank) uci = uci + 'q';
  try {
    const headers = {'Content-Type': 'application/json'};
    const token = window.playerToken();  // #34 : the move is played by the token's player
    if (token) headers['Authorization'] = 'Bearer ' + token;
    const r = await fetch('/api/games/' + encodeURIComponent(gid) + '/move', {
      method: 'POST',
      headers,
      body: JSON.stringify({ uci }),
    });
    if (!r.ok) {
      // Revert to pre-drop FEN. The server rejected : illegal move (422),
      // missing / invalid token (401), not this player's turn or game (403).
      if (cgFenSnapshot && cg) cg.set({ fen: cgFenSnapshot });
      const body = await r.json().catch(() => ({}));
      showMoveError(body.detail || ('HTTP ' + r.status));
      return;
    }
    // Successful move — the SSE stream will push the fresh state, and
    // pollPositions() will refresh the moves list. Don't manually
    // update chessground here to avoid double-update flicker.
  } catch (e) {
    if (cgFenSnapshot && cg) cg.set({ fen: cgFenSnapshot });
    showMoveError('Network error');
  }
}

// Public setter used by the classical polling loop's draw() function.
// ``turn`` may be null → viewOnly; otherwise 'white'|'black'.
// ``interactive`` toggles drag&drop (true at live position, false in history).
window.__cgSetFen = function(fen, turn, interactive) {
  if (!cg) return;
  if (!fen) {
    cg.set({ fen: 'start', viewOnly: true, movable: { color: undefined, free: false } });
    return;
  }
  cgFenSnapshot = fen;
  cg.set({
    fen,
    turnColor: turn || undefined,
    viewOnly: !interactive,
    movable: {
      free: true,  // server validates via POST /move ; client is permissive
      color: interactive ? turn : undefined,
      showDests: false,
      events: { after: onUserDrop },
    },
  });
};

cg = Chessground(boardEl, {
  fen: 'start',
  orientation: 'white',
  viewOnly: true,
  animation: { enabled: true, duration: 200 },
  movable: { free: true, color: undefined, events: { after: onUserDrop } },
  draggable: { showGhost: true },
});

// Re-attach the error overlay after chessground has taken over the div.
if (errorEl) boardEl.appendChild(errorEl);

// Once chessground is ready, re-trigger the classical draw() so the
// board catches up with any positions already polled by the sibling
// script. ``window.draw`` is populated by the classical <script>
// (top-level function declarations are globals in non-module scripts).
if (typeof window.draw === 'function') window.draw();
