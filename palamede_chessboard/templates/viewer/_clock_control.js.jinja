// Starting the clock, or playing without it (FIDE 6.6 and 6.2.1, #330). In a
// game with a clock, no move is accepted until a participant starts it : the
// « Lancer la pendule » key, the arbiter's gesture, open to any player whatever
// their side ; the clocks themselves no longer start anything. A tablier.*
// game may be started here too, never switched off : until #335 its first move
// starts it. The seat and the game come from the game-end band (#275).
const clocksBox = document.getElementById('clocks');
const clockNote = document.getElementById('clock-note');
let CLOCK_NOTE = '';

function clockSettable() {
  const { colors, data } = GAME_END;
  const live = data && data.result === '*' && !data.is_game_over;
  return !!(CLOCK && !CLOCK.started && !CLOCK.off_by && colors.length && live);
}

function clockNoteHtml(settable) {
  if (CLOCK && CLOCK.off_by) {
    return 'Pendule coupée par <strong>' + escapeHtml(CLOCK.off_by) + '</strong> : partie sans pendule.';
  }
  if (!settable) return '';
  const firstMove = !(GAME_END.data.san_history || []).length;
  const tablier = gameId().startsWith('tablier.');
  return '<button type="button" data-clock="start">Lancer la pendule</button>'
    + (tablier ? ' La pendule part aussi au premier coup posé sur l\'échiquier.'
      : ' Aucun coup avant le lancement.')
    + (firstMove && !tablier ? ' <button type="button" data-clock="off">Jouer sans pendule</button>' : '');
}

function renderClockControl() {
  const settable = clockSettable();
  clocksBox.classList.toggle('off', !!(CLOCK && CLOCK.off_by));
  const html = clockNoteHtml(settable)
    + (CLOCK_NOTE ? ' <span class="clock-error">' + escapeHtml(CLOCK_NOTE) + '</span>' : '');
  clockNote.innerHTML = html;
  clockNote.hidden = !html;
}

async function clockAction(action) {
  CLOCK_NOTE = '';
  try {
    const r = await fetch('/api/games/' + encodeURIComponent(gameId()) + '/clock/' + action, {
      method: 'POST', headers: { 'Authorization': 'Bearer ' + playerToken() },
    });
    if (!r.ok) {
      let body = {};
      try { body = await r.json(); } catch (_) { /* no body */ }
      CLOCK_NOTE = typeof body.detail === 'string' ? body.detail : 'Refusé (HTTP ' + r.status + ').';
    }
  } catch (_) {
    CLOCK_NOTE = 'Serveur injoignable.';
  }
  await pollClock();  // renders the clock and this note
}

clockNote.addEventListener('click', ev => {
  const key = ev.target.closest('[data-clock]');
  if (!key) return;
  if (key.dataset.clock === 'start') {
    if (clockSettable()) clockAction('start');
    return;
  }
  if (!window.confirm('Jouer cette partie sans pendule ? Ce sera définitif.')) return;
  clockAction('off');
});
