// « Mes exercices » (#95 step 2) : the token's own progress and exercises.
// Read when the panel is opened, never polled (Admin, #95) ; nothing shows
// without a token. The progress is counts only : no solution reaches here.
const MOTIF_LABELS = {
  missed_mate: 'Mat manqué',
  hanging_piece: 'Pièce laissée en prise',
  ignored_threat: 'Menace ignorée',
  lone_queen: 'Dame partie seule',
  weakened_king: 'Roi affaibli',
  other: 'Autre',
};
function motifLabel(m) { return MOTIF_LABELS[m] || m; }
// A count or a rate from the server, as a number or « — » : never raw text
// in the HTML, even if the server sent one (review Admin #218).
function num(v) {
  const n = Number(v);
  return v !== null && v !== undefined && v !== '' && Number.isFinite(n) ? String(n) : '—';
}
const coachBox = document.getElementById('coach');
const coachBody = document.getElementById('coach-body');

function coachHeaders() {
  const token = playerToken();
  return token ? { 'Authorization': 'Bearer ' + token } : {};
}

function coachRefusal(status) {
  if (status === 401) return 'Jeton refusé : vérifiez-le avec 🔑.';
  if (status === 503) return 'Exercices illisibles pour le moment, réessayez plus tard.';
  return 'Exercices indisponibles (HTTP ' + status + ').';
}

// The reminder : only when exercises wait and none was tried lately (Stéphane, 05/11).
function reminderHtml(p) {
  const r = p.reminder || {};
  if (!r.due) return '';
  let text = num(r.waiting) + (r.waiting > 1 ? ' exercices t\'attendent' : ' exercice t\'attend');
  if (r.days_since_last_attempt !== null && r.days_since_last_attempt !== undefined) {
    text += ', dernier exercice il y a ' + num(r.days_since_last_attempt) + ' jour' + (r.days_since_last_attempt > 1 ? 's' : '');
  }
  if (p.suggestion) text += '. Suggestion : ' + motifLabel(p.suggestion.motif);
  return '<div class="coach-reminder">' + escapeHtml(text) + '.</div>';
}

function rate(m) { return num(m.per_100_moves); }

// Per motif : mistakes per 100 moves, last 10 games against the 10 before
// (Stéphane, 05/11), with the counts ; the first try and the abandons apart.
function progressHtml(p) {
  const g = p.games, ex = p.exercises || {};
  let html = '<table><thead><tr><th>motif</th><th class="num" title="erreurs pour 100 coups, 10 dernières parties">récent</th>'
    + '<th class="num" title="erreurs pour 100 coups, les 10 parties d\'avant">avant</th>'
    + '<th class="num" title="réussis du premier coup / tentés">1er essai</th><th class="num">abandons</th></tr></thead><tbody>';
  Object.keys(MOTIF_LABELS).forEach(m => {
    const e = ex[m];
    const recent = g.recent.motifs[m], before = g.before.motifs[m];
    if (!recent.mistakes && !before.mistakes && !e) return;
    const first = e ? num(e.first_try.ok) + ' / ' + num(e.first_try.tried) : '—';
    html += '<tr><td>' + escapeHtml(motifLabel(m)) + '</td><td class="num">' + rate(recent) + '</td><td class="num">'
      + rate(before) + '</td><td class="num">' + first + '</td><td class="num">' + (e ? num(e.abandoned_games) : '0') + '</td></tr>';
  });
  html += '</tbody></table>';
  html += '<div class="coach-counts">' + num(g.recent.games) + ' parties récentes, ' + num(g.before.games) + ' avant';
  if (!g.enough) html += ' : pas assez de parties pour comparer';
  return html + '.</div>';
}

// The two forms (#230) : a move, on the Tablier or with the mouse, or
// squares, typed in this page only — said on each line, not guessed.
const KIND_LABELS = {
  find_move: 'Trouvez le bon coup · Tablier ou souris',
  attacked: 'Cases attaquées · visionneuse seulement',
};
// Where the player stands on an exercise (Stéphane, 05/11). The server's
// state only judges the last game : missed then found in that game is
// « failed », like never found. The attempts tell them apart ; an abandon
// (ok false) finds nothing. A colour per standing, and always its words
// beside it (review Admin : colour-blind readers, screen readers).
const STANDING_LABELS = {
  todo: 'à faire',
  never: 'à reprendre · jamais trouvé',
  found: 'à reprendre · déjà trouvé',
  solved: 'résolu',
};
function standing(e) {
  if (e.state === 'solved') return 'solved';
  // Abandons only : the server keeps « proposed », yet it was tried (review Admin #242).
  const tries = Array.isArray(e.attempts) ? e.attempts : [];
  if (e.state !== 'failed' && !tries.length) return 'todo';
  return tries.some(a => a && a.ok === true && !a.abandoned) ? 'found' : 'never';
}
function standingHtml(e) {
  const s = standing(e);
  if (s === 'todo') return '';
  return ' · <span class="standing st-' + s + '"><span class="dot" aria-hidden="true"></span>'
    + escapeHtml(STANDING_LABELS[s]) + '</span>';
}
function kindLabel(k) { return KIND_LABELS[k] || k; }

function exerciseItem(e, suggested) {
  return '<li' + (suggested ? ' class="suggested"' : '') + '><span>'
    + (suggested ? '<strong>Suggéré</strong> · ' : '')
    + escapeHtml(motifLabel(e.motif)) + ' · ' + escapeHtml(kindLabel(e.kind))
    + standingHtml(e) + '</span>'
    + '<button type="button" data-start="' + escapeHtml(e.id) + '" data-side="' + escapeHtml(e.side) + '" data-kind="'
    + escapeHtml(e.kind) + '" data-motif="' + escapeHtml(e.motif) + '">Lancer</button></li>';
}

// The short list (#230) : the first SHORT_LIST of the server's queue, the
// suggestion first. The order is the server's (/progress), never redone here.
const SHORT_LIST = 5;
const FILTER_KEY = 'palamede-coach-filter';
let COACH_WAITING = [];
// Every exercise, solved ones last : the full list, behind the filter.
let COACH_ALL = [];
// The filter in use : read back at each load, then kept here, so that it
// applies even where sessionStorage is refused (review Admin #233).
let COACH_FILTER = { motif: '', state: '', kind: '' };

function inQueueOrder(list, ids) {
  const waiting = list.filter(e => e.state !== 'solved');
  const rank = new Map((ids || []).map((id, i) => [id, i]));
  const at = e => (rank.has(e.id) ? rank.get(e.id) : rank.size);
  return waiting.map((e, i) => [at(e), i, e]).sort((a, b) => a[0] - b[0] || a[1] - b[1]).map(x => x[2]);
}

function savedFilter() {
  let f = {};
  try { f = JSON.parse(sessionStorage.getItem(FILTER_KEY) || '{}') || {}; } catch (_) { f = {}; }
  return {
    motif: Object.hasOwn(MOTIF_LABELS, f.motif) ? f.motif : '',
    state: Object.hasOwn(STANDING_LABELS, f.state) ? f.state : '',
    kind: Object.hasOwn(KIND_LABELS, f.kind) ? f.kind : '',
  };
}

function filterSelect(name, all, labels, chosen) {
  return '<select data-filter="' + name + '"><option value="">' + all + '</option>'
    + Object.keys(labels).map(k => '<option value="' + escapeHtml(k) + '"' + (k === chosen ? ' selected' : '') + '>'
      + escapeHtml(labels[k]) + '</option>').join('') + '</select>';
}

function filteredHtml(f) {
  const shown = COACH_ALL.filter(e => (!f.motif || e.motif === f.motif)
    && (!f.state || standing(e) === f.state) && (!f.kind || e.kind === f.kind));
  if (!shown.length) return '<div class="empty">Aucun exercice pour ce filtre.</div>';
  return '<ul class="coach-list">' + shown.map(e => exerciseItem(e, false)).join('') + '</ul>';
}

function exercisesHtml(list, progress) {
  COACH_WAITING = inQueueOrder(list, progress.queue);
  COACH_ALL = COACH_WAITING.concat(list.filter(e => e.state === 'solved'));
  if (!COACH_ALL.length) return '<div class="empty">Aucun exercice en attente.</div>';
  const f = COACH_FILTER = savedFilter();
  const short = COACH_WAITING.length
    ? '<ul class="coach-list">' + COACH_WAITING.slice(0, SHORT_LIST).map((e, i) => exerciseItem(e, i === 0)).join('') + '</ul>'
    : '<div class="empty">Aucun exercice en attente.</div>';
  return short
    + '<details class="coach-all"><summary>Voir tous les exercices (' + num(COACH_ALL.length) + ')</summary>'
    + '<div class="coach-filter">' + filterSelect('motif', 'tous les motifs', MOTIF_LABELS, f.motif)
    + filterSelect('state', 'tous les états', STANDING_LABELS, f.state)
    + filterSelect('kind', 'toutes les formes', KIND_LABELS, f.kind) + '</div>'
    + '<div id="coach-all-list">' + filteredHtml(f) + '</div></details>';
}

// A filter change : kept for the tab (sessionStorage, like the token), and
// the full list redrawn from what was read — nothing is fetched again.
function onFilterChange(select) {
  const f = COACH_FILTER;
  f[select.dataset.filter] = select.value;
  try { sessionStorage.setItem(FILTER_KEY, JSON.stringify(f)); } catch (_) { /* kept in COACH_FILTER for this load */ }
  const box = document.getElementById('coach-all-list');
  if (box) box.innerHTML = filteredHtml(f);
}

async function loadCoach() {
  if (!playerToken()) {
    coachBody.innerHTML = '<div class="empty">Collez votre jeton avec 🔑 pour voir vos exercices.</div>';
    return;
  }
  coachBody.innerHTML = '<div class="empty">Chargement…</div>';
  try {
    const [rp, re] = await Promise.all([
      fetch('/api/coach/progress', { cache: 'no-store', headers: coachHeaders() }),
      fetch('/api/coach/exercises', { cache: 'no-store', headers: coachHeaders() }),
    ]);
    if (!rp.ok || !re.ok) { coachBody.innerHTML = '<div class="empty">' + escapeHtml(coachRefusal(rp.ok ? re.status : rp.status)) + '</div>'; return; }
    const progress = await rp.json(), exercises = (await re.json()).exercises || [];
    coachBody.innerHTML = reminderHtml(progress) + progressHtml(progress) + exercisesHtml(exercises, progress);
  } catch (_) {
    coachBody.innerHTML = '<div class="empty">Exercices indisponibles (réseau).</div>';
  }
}

// The band under the board (#237) : the exercise's family, its rule, and for
// « what is attacked ? » the answer box — in the panel, it went unseen below
// the list (Stéphane, 05/11). The Tablier says the same texts.
const EXERCISE_TEXTS = {
  find_move: {
    title: 'Trouvez le bon coup',
    rule: "Trouvez le meilleur coup dans cette position, dans l'app Tablier ou à la souris dans la visionneuse. "
      + 'Un coup faux est refusé et la position reste en place : réessayez.',
  },
  attacked: {
    title: 'Cases attaquées',
    rule: 'Tapez les cases de vos pièces en prise, séparées par des espaces, puis Entrée. '
      + 'En prise : attaquée et non défendue, ou attaquée par une pièce de moindre valeur. '
      + "Votre roi n'est jamais à désigner. Le roi adverse ne compte que contre une pièce non défendue. "
      + 'Donnez toutes les cases, sans en ajouter.',
  },
};
// Why this position (Stéphane, 05/11) : the mistake of the game, as the
// motifs define it (coach/motifs.py). Not « parez la menace » : the
// solution is the engine's best move, not always the one that saves it.
const EXERCISE_CONTEXTS = {
  missed_mate: 'Dans votre partie, un mat forcé était possible ici, et il a été manqué.',
  hanging_piece: 'Dans votre partie, le coup joué ici a laissé une de vos pièces en prise.',
  ignored_threat: "Dans votre partie, une de vos pièces était déjà en prise ici, et le coup joué ne l'a pas sauvée.",
};
const exerciseBand = document.getElementById('exercise-band');
let EXERCISE_GAME = '';

function showExerciseBand(id, kind, motif, game) {
  const texts = EXERCISE_TEXTS[kind];
  EXERCISE_GAME = texts ? game : '';
  exerciseBand.hidden = !texts;
  if (!texts) return;
  exerciseBand.dataset.exercise = id;
  const context = EXERCISE_CONTEXTS[motif];
  // Without a known motif, the family alone — as the Tablier (exercise.py).
  const title = context ? motifLabel(motif) + ' · ' + texts.title : texts.title;
  exerciseBand.innerHTML = '<div class="band-title">' + escapeHtml(title) + '</div>'
    + (context ? '<div class="band-context">' + escapeHtml(context) + '</div>' : '')
    + '<div class="band-rule">' + escapeHtml(texts.rule) + '</div>'
    + (kind === 'attacked'
      ? '<form id="band-answer"><label>Cases (ex. f6 e4) : <input type="text" id="coach-squares" autocomplete="off"></label>'
        + ' <button type="submit">Répondre</button></form>'
      : '')
    + '<div id="coach-answer-msg"></div>';
  exerciseBand.scrollIntoView({ block: 'nearest' });
  if (kind === 'attacked') document.getElementById('coach-squares').focus();
}

function hideExerciseBand() { EXERCISE_GAME = ''; exerciseBand.hidden = true; }

// Whatever opened the game (« Lancer », the games list, the URL, a reload) :
// an exo.* game of the token's exercises shows its band (Leader, 05/11).
// Read by game_ids ; a band already shown for this game is left as it is,
// so the field keeps what was typed.
async function refreshExerciseBand(game) {
  if (game === EXERCISE_GAME) return;
  hideExerciseBand();
  if (!game.startsWith('exo.') || !playerToken()) return;
  try {
    const r = await fetch('/api/coach/exercises', { cache: 'no-store', headers: coachHeaders() });
    if (!r.ok) return;
    const list = (await r.json()).exercises || [];
    const e = list.find(x => Array.isArray(x.game_ids) && x.game_ids.includes(game));
    if (e && gameId() === game && EXERCISE_GAME !== game) showExerciseBand(e.id, e.kind, e.motif, game);
  } catch (_) { /* no band : the game still shows */ }
}

// « Lancer » : the exercise's game opens in this page, the player's side at
// the bottom. « What is attacked ? » is answered with squares, not a move.
async function startExercise(id, side, kind, motif) {
  const r = await fetch('/api/coach/exercises/' + encodeURIComponent(id) + '/start', { method: 'POST', headers: coachHeaders() });
  let body = {};
  try { body = await r.json(); } catch (_) { /* no body */ }
  if (!r.ok) { coachBody.insertAdjacentHTML('afterbegin', '<div class="coach-error">' + escapeHtml(body.detail || coachRefusal(r.status)) + '</div>'); return; }
  ORIENT = side === 'black' ? 'black' : 'white';
  selectGame(body.game_id);
  applyOrientation();
  showExerciseBand(id, kind, motif, body.game_id);
}

async function answerExercise(id) {
  const squares = (document.getElementById('coach-squares').value || '').split(/[\s,;]+/).filter(Boolean);
  const r = await fetch('/api/coach/exercises/' + encodeURIComponent(id) + '/answer', {
    method: 'POST', headers: { ...coachHeaders(), 'Content-Type': 'application/json' }, body: JSON.stringify({ squares }),
  });
  let body = {};
  try { body = await r.json(); } catch (_) { /* no body */ }
  const msg = document.getElementById('coach-answer-msg');
  msg.textContent = r.ok ? 'Bonne réponse !' : (typeof body.detail === 'string' ? body.detail : coachRefusal(r.status));
  if (r.ok) resetAndPoll();
}

coachBox.addEventListener('toggle', () => { if (coachBox.open) loadCoach(); });
coachBody.addEventListener('change', ev => { if (ev.target.dataset.filter) onFilterChange(ev.target); });
coachBody.addEventListener('click', ev => {
  const start = ev.target.closest('[data-start]');
  if (start) startExercise(start.dataset.start, start.dataset.side, start.dataset.kind, start.dataset.motif);
});
// A form : Entrée answers, like the button (nit of Admin, #235).
exerciseBand.addEventListener('submit', ev => { ev.preventDefault(); answerExercise(exerciseBand.dataset.exercise); });
document.getElementById('key-btn').addEventListener('click', () => {
  if (coachBox.open) loadCoach();
  hideExerciseBand();
  if (gameId()) refreshExerciseBand(gameId());
});
if (gameId()) refreshExerciseBand(gameId());
