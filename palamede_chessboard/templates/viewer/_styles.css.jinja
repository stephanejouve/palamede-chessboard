  :root {
    color-scheme: light dark;
    --bg: #f8f7f4;
    --surface: #fff;
    --surface-2: #ecebe6;
    --text: #2a2a28;
    --text-muted: #7a7973;
    --accent: #4a7c9d;
    --accent-bg: #e6f0f7;
    --border: #e0dfd9;
    --eval-white: #f5f5f0;
    --eval-black: #1a1a1a;
    --warning: #d35858;
    --ok: #4caf50;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1a1a1a;
      --surface: #242422;
      --surface-2: #2e2e2c;
      --text: #e8e7e3;
      --text-muted: #9a998f;
      --accent: #7eb6dc;
      --accent-bg: #2a3a48;
      --border: #3a3a37;
      --eval-white: #f0f0eb;
      --eval-black: #0a0a0a;
    }
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, "SF Pro Text", system-ui, "Segoe UI", sans-serif;
    background: var(--bg);
    color: var(--text);
    margin: 0;
    padding: 24px;
    /* Center the .wrap vertically when the viewport is taller than the */
    /* content (large desktop / fullscreen). On mobile / short viewports */
    /* the content overflows naturally — flex-start lets it scroll.     */
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }
  .wrap { max-width: 820px; width: 100%; }
  .header { display: flex; justify-content: space-between; align-items: baseline; padding: 12px 16px; background: var(--surface-2); border-radius: 8px; margin-bottom: 16px; flex-wrap: wrap; gap: 8px; font-size: 13px; }
  .header strong { font-weight: 600; }
  .opening { font-size: 12px; color: var(--text-muted); margin-top: 4px; flex-basis: 100%; }
  .gsel { position: relative; display: inline-block; }
  .gsel-panel { position: absolute; z-index: 20; top: calc(100% + 4px); left: 0; width: min(420px, 92vw); max-height: 60vh; overflow-y: auto; padding: 6px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; box-shadow: 0 6px 24px rgba(0,0,0,.25); }
  .gsel-sec { margin: 8px 4px 4px; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); }
  .gsel-item { display: block; width: 100%; text-align: left; padding: 6px 8px; border: 0; border-radius: 6px; background: transparent; color: var(--text); cursor: pointer; }
  .gsel-item:hover, .gsel-item.current { background: var(--surface-2); }
  .gsel-id { font-family: ui-monospace, monospace; font-size: 13px; }
  .gsel-meta { display: block; font-size: 11px; color: var(--text-muted); }
  .gsel-badge { margin-left: 6px; padding: 0 6px; border-radius: 8px; font-size: 10px; background: var(--surface-2); color: var(--text-muted); }
  .gsel-empty { padding: 4px 8px; font-size: 12px; color: var(--text-muted); }
  .gsel-opt { float: right; font-size: 11px; color: var(--text-muted); }
  .gsel-more { width: 100%; margin-top: 4px; padding: 6px; border: 1px dashed var(--border); border-radius: 6px; background: transparent; color: var(--text-muted); cursor: pointer; }
  .gameid-input { padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--surface); color: var(--text); font-family: ui-monospace, monospace; font-size: 13px; width: 260px; }
  .key-btn { padding: 4px 8px; margin-left: 6px; border-radius: 6px; border: 1px solid var(--border); background: var(--surface); cursor: pointer; opacity: .55; }
  .key-btn.on { opacity: 1; border-color: var(--text-muted); }
  .role-select { padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--surface); color: var(--text); font-size: 12px; margin-left: 6px; }
  .layout { display: grid; grid-template-columns: 400px 1fr; gap: 18px; align-items: start; }
  @media (max-width: 760px) { .layout { grid-template-columns: 1fr; } }
  /* Board container : sized precisely so chessground computes square sizes
     correctly. If the chessground CDN fails to load, the container stays
     empty (blank grey square) but the rest of the UI (moves, engine,
     commentary) keeps working — degradation is graceful. */
  #board { display: block; width: 400px; height: 400px; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.15); background: var(--surface-2); position: relative; }
  #board.cg-wrap { background: transparent; }
  /* Chessground default coord positioning has files at ``bottom: -4px`` and
     ranks at ``top: -20px`` — half-outside the board box. Combined with our
     ``overflow: hidden`` (needed to clip pieces during drag against the
     border-radius), the labels get chopped to sliver-height. Override to
     tuck them fully inside the board edge, and boost font-size/weight so
     they're readable at 50px squares (400px board). */
  /* Chessground default has ``left: 24px`` on coords.files which shifts the
     entire row nearly half a square to the right — "A" ends up over the a/b
     boundary and every letter looks off by one file. Reset ``left: 0`` so
     each flex item (100%/8 = 50px wide, text-aligned center) lands centered
     in its own file's rank-1 square. */
  /* Position labels in the CORNERS of each square, away from where the
     piece SVG sits (which occupies the center ~90% of the square) :
       * ranks (numbers)  → top-left corner of a-file, rank-N square
       * files (letters)  → bottom-right corner of file-X, rank-1 square
     Combined with a strong contrasting text-shadow below, labels stay
     legible even when a piece sits on the same square. ``z-index: 3``
     guarantees we paint above the piece layer as a belt-and-braces. */
  .cg-wrap coords { z-index: 3; opacity: 1; }
  .cg-wrap coords.files {
    bottom: 2px; left: 0;
    font-size: 10px; font-weight: 600;
    text-align: right; padding-right: 3px;
  }
  .cg-wrap coords.ranks {
    top: 2px; left: 2px;
    font-size: 10px; font-weight: 600;
    text-align: left;
  }
  /* Convention Lichess / Chess.com : la couleur d'une coordonnée est
     TOUJOURS le complément de la case sur laquelle elle est posée (texte
     sombre sur case claire, texte clair sur case sombre). Standard chess :
     a1 est SOMBRE.

     Chessground rend les coords comme ``<coords class="files"><coord>a
     </coord>...</coords>`` et le sélecteur natif ``coord:nth-child(...)``
     alterne les couleurs. Il faut donc raisonner sur l'ORDRE des enfants
     dans le DOM, qui dépend de l'orientation :

     Orientation Blancs (coords.files enfants gauche→droite = a,b,c,...,h) :
       * child(1)=a (rank 1 = a1 sombre) → texte CLAIR
       * child(2)=b (rank 1 = b1 claire) → texte SOMBRE
       → files : odd=CLAIR, even=SOMBRE
     Orientation Blancs (coords.ranks enfants bas→haut = 1,2,3,4,5,6,7,8
     depuis chessground 9.2.x — l'ordre DOM a été inversé par rapport à
     l'ancienne version, découverte user 2026-10-05) :
       * child(1)=rank 1 (a1 sombre) → texte CLAIR
       * child(2)=rank 2 (a2 claire) → texte SOMBRE
       → ranks : odd=CLAIR, even=SOMBRE

     Orientation Noirs (l'échiquier est retourné) :
       * files enfants gauche→droite = h,g,f,e,d,c,b,a
       * ranks enfants bas→haut = 8,7,6,5,4,3,2,1
       Les deux règles s'inversent par rapport aux blancs.

     Chessground pose la classe ``.orientation-white`` ou
     ``.orientation-black`` sur le wrap → on peut cibler l'orientation
     directement. Selectors avec ``coord`` (au lieu de juste ``:nth-child``)
     pour matcher la spécificité native de chessground.brown.css et éviter
     les collisions de cascade. Pas de text-shadow : le contraste
     complément-de-case suffit (CD 2026-09-30). */
  /* Files letters — couleur CLAIRE (sur case sombre) */
  .cg-wrap.orientation-white coords.files coord:nth-child(odd),
  .cg-wrap.orientation-black coords.files coord:nth-child(even) {
    color: rgba(255, 255, 255, 0.95);
  }
  /* Files letters — couleur SOMBRE (sur case claire) */
  .cg-wrap.orientation-white coords.files coord:nth-child(even),
  .cg-wrap.orientation-black coords.files coord:nth-child(odd) {
    color: rgba(50, 50, 50, 0.95);
  }
  /* Ranks numbers — couleur CLAIRE (sur case sombre a1/a3/a5/a7) */
  .cg-wrap.orientation-white coords.ranks coord:nth-child(odd),
  .cg-wrap.orientation-black coords.ranks coord:nth-child(even) {
    color: rgba(255, 255, 255, 0.95);
  }
  /* Ranks numbers — couleur SOMBRE (sur case claire a2/a4/a6/a8) */
  .cg-wrap.orientation-white coords.ranks coord:nth-child(even),
  .cg-wrap.orientation-black coords.ranks coord:nth-child(odd) {
    color: rgba(50, 50, 50, 0.95);
  }
  #move-error { position: absolute; bottom: 8px; left: 8px; right: 8px; padding: 6px 10px; border-radius: 4px; background: rgba(211, 88, 88, 0.9); color: white; font-size: 12px; opacity: 0; transition: opacity 0.2s; pointer-events: none; }
  #move-error.show { opacity: 1; }
  .clocks { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
  .clock { padding: 12px; border-radius: 8px; background: var(--surface-2); text-align: center; transition: background 0.15s; }
  .clock.active { background: var(--accent-bg); box-shadow: inset 0 0 0 2px var(--accent); }
  .clock.low { background: rgba(211, 88, 88, 0.18); animation: pulse-low 1s infinite; }
  .clock .label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
  .clock .time { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 26px; font-weight: 600; margin-top: 4px; }
  @keyframes pulse-low { 50% { opacity: 0.65; } }
  .moves { padding: 12px; background: var(--surface-2); border-radius: 8px; font-size: 13px; line-height: 1.9; max-height: 200px; overflow-y: auto; }
  .commentary { padding: 12px; background: var(--surface-2); border-radius: 8px; font-size: 13px; line-height: 1.5; max-height: 280px; overflow-y: auto; margin-top: 10px; }
  .commentary h3, .engine h3 { margin: 0 0 8px 0; font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; }
  .commentary .entry { margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
  .commentary .entry:last-child { border-bottom: none; }
  .commentary .src { font-weight: 600; color: var(--accent); font-size: 11px; }
  .commentary .ts { font-size: 10px; color: var(--text-muted); float: right; }
  .commentary .txt { margin-top: 4px; white-space: pre-wrap; }
  .commentary .empty, .engine .empty, .captures .empty { color: var(--text-muted); font-style: italic; font-size: 12px; }
  .captures { padding: 12px; background: var(--surface-2); border-radius: 8px; font-size: 13px; margin-top: 10px; }
  .captures h3 { margin: 0 0 8px 0; font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; }
  .captures .row { display: flex; align-items: center; gap: 8px; padding: 4px 0; font-size: 15px; line-height: 1.4; }
  .captures .row .side { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; min-width: 48px; }
  .captures .row .pieces { flex: 1; display: flex; flex-wrap: wrap; gap: 2px; align-items: center; }
  .captures .row .pieces img { width: 22px; height: 22px; vertical-align: middle; }
  .elo-board { padding: 12px; background: var(--surface-2); border-radius: 8px; font-size: 13px; margin-top: 10px; }
  .elo-board h3 { margin: 0 0 8px 0; font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; display: flex; justify-content: space-between; align-items: center; }
  .elo-board h3 .source { font-size: 10px; font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--text-muted); font-style: italic; }
  .elo-board table { width: 100%; border-collapse: collapse; font-size: 12px; font-family: ui-monospace, monospace; }
  .elo-board th { text-align: left; padding: 4px 6px; color: var(--text-muted); font-weight: 600; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid var(--border); }
  .elo-board th.num, .elo-board td.num { text-align: right; }
  .elo-board td { padding: 4px 6px; border-bottom: 1px solid var(--border); }
  .elo-board tr:last-child td { border-bottom: none; }
  .elo-board td.rank { color: var(--text-muted); width: 24px; }
  .elo-board td.name { font-weight: 600; }
  .elo-board td.rating { font-weight: 600; color: var(--accent); }
  .elo-board .empty { color: var(--text-muted); font-style: italic; font-size: 12px; }
  .captures .row .balance { font-family: ui-monospace, monospace; font-size: 13px; font-weight: 600; min-width: 36px; text-align: right; }
  .captures .row .balance.plus { color: var(--ok); }
  .captures .row .balance.minus { color: var(--warning); }
  .captures .row .balance.even { color: var(--text-muted); }
  .engine { padding: 12px; background: var(--surface-2); border-radius: 8px; font-size: 13px; margin-top: 10px; }
  .engine .eval-bar { height: 18px; border-radius: 4px; background: linear-gradient(to right, var(--eval-black) 50%, var(--eval-white) 50%); position: relative; overflow: hidden; margin-bottom: 8px; }
  .engine .eval-bar .indicator { position: absolute; top: 0; left: 50%; width: 2px; height: 100%; background: var(--accent); transform: translateX(-1px); transition: left 0.3s; }
  .engine .eval-line { font-family: ui-monospace, monospace; font-size: 13px; line-height: 1.6; }
  .engine .eval-cp { font-weight: 600; }
  .engine .eval-best { color: var(--accent); font-weight: 600; }
  .engine .eval-pv { color: var(--text-muted); font-size: 12px; }
  .engine .locked { background: rgba(211, 88, 88, 0.10); padding: 8px; border-radius: 4px; color: var(--warning); font-size: 12px; }
  .mv { display: inline-block; padding: 2px 7px; margin: 1px 2px; border: none; border-radius: 4px; font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 13px; cursor: pointer; color: var(--text); background: transparent; }
  .mv:hover { background: var(--surface); }
  .mv.act { background: var(--accent-bg); color: var(--accent); font-weight: 600; }
  .num { color: var(--text-muted); padding: 0 2px 0 6px; font-family: ui-monospace, monospace; font-size: 13px; }
  .controls { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 12px; }
  .controls button { padding: 6px 12px; border-radius: 6px; border: 1px solid var(--border); background: var(--surface); color: var(--text); cursor: pointer; font-size: 14px; line-height: 1; min-width: 36px; }
  .controls button:hover { background: var(--surface-2); }
  .ct { font-size: 12px; min-width: 64px; text-align: center; font-family: ui-monospace, monospace; color: var(--text-muted); }
  .status { display: flex; justify-content: space-between; align-items: center; margin-top: 14px; font-size: 12px; color: var(--text-muted); flex-wrap: wrap; gap: 8px; }
  .live { display: inline-flex; align-items: center; gap: 6px; }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); animation: pulse 2s infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.85); } }
  .pulse.off { background: #888; animation: none; }
  .err { color: var(--warning); }
