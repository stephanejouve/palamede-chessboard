const params = new URLSearchParams(location.search);
const gameIdInput = document.getElementById('gameid');
const roleSelect = document.getElementById('role');
// The displayed game is explicit state (#46) : typing a search in the
// selector must not change which game the polls follow.
let CURRENT_GAME = (params.get('game') || '').trim();
gameIdInput.value = CURRENT_GAME;
roleSelect.value = params.get('viewer') || 'spectator';

let POS = [];
let idx = 0;
let lastResult = '*';
let COMMENTS = [];
let CLOCK = null;
let clockServerTs = 0;
let clockClientTs = 0;
let userPinned = false;

function gameId() { return CURRENT_GAME; }
function viewerRole() { return roleSelect.value; }
function qs(extra) { return '?game_id=' + encodeURIComponent(gameId()) + (extra ? '&' + extra : ''); }

// Board orientation : Black at the bottom for the black player. It follows
// the role (player_black → black) unless flipped by hand ; a manual flip is
// kept in the URL (``orient``) so that a shared link keeps it.
let ORIENT = ['white', 'black'].includes(params.get('orient')) ? params.get('orient') : '';
function boardOrientation() {
  if (ORIENT) return ORIENT;
  return viewerRole() === 'player_black' ? 'black' : 'white';
}
// No-op until the chessground module is up ; it reads boardOrientation()
// at creation, whichever script runs first.
function applyOrientation() {
  if (window.__cgSetOrientation) window.__cgSetOrientation(boardOrientation());
}

// The role follows the token's seat in the game shown (#337), read again at
// each game change : White, Black, or no seat. A player's role is never kept
// from the previous game ; a role chosen by hand that is not a seat (arbiter,
// post_mortem) stays as it is.
function seatRole(colors) {
  if (colors.length === 1) return 'player_' + colors[0];
  if (colors.length === 2) return viewerRole() === 'player_black' ? 'player_black' : 'player_white';
  return viewerRole().startsWith('player_') ? 'spectator' : viewerRole();
}
function applySeatRole(colors) {
  const role = seatRole(colors);
  if (role === viewerRole()) return;
  roleSelect.value = role;
  ORIENT = '';  // a new role resets the orientation to its own side
  updateUrl(); applyOrientation(); pollEngine();
}

roleSelect.addEventListener('change', () => {
  ORIENT = '';  // a new role resets the orientation to its own side
  updateUrl(); applyOrientation(); pollEngine();
});
document.getElementById('flip-btn').addEventListener('click', () => {
  ORIENT = boardOrientation() === 'white' ? 'black' : 'white';
  updateUrl(); applyOrientation();
});

// Player token (#34) : pasted once, kept in sessionStorage — forgotten
// when the tab closes, never in localStorage nor in the URL. Sent as
// ``Authorization: Bearer`` with the moves played on the board.
const TOKEN_KEY = 'palamede-player-token';
function playerToken() {
  try { return sessionStorage.getItem(TOKEN_KEY) || ''; } catch (_) { return ''; }
}
// Who the token belongs to (#229) : asked to ``/api/me`` at load and after
// each change, the token in a header. The click reads the last answer
// without waiting, so the coach panel reloads with the new token.
const KEY_TITLE = 'Jeton de joueur (pour jouer depuis le viewer)';
let KEY_WHO = { state: 'none', player: '' };
async function checkToken() {
  const token = playerToken();
  KEY_WHO = { state: token ? 'checking' : 'none', player: '' };
  showKeyState();
  if (!token) return;
  let next = { state: 'unknown', player: '' };
  try {
    const r = await fetch('/api/me', { headers: { 'Authorization': 'Bearer ' + token }, cache: 'no-store' });
    if (r.ok) next = { state: 'ok', player: String((await r.json()).player || '') };
    else if (r.status === 401) next = { state: 'refused', player: '' };
  } catch (_) { /* viewer unreachable : the player stays unknown */ }
  if (playerToken() !== token) return;  // changed meanwhile : the newer check answers
  KEY_WHO = next;
  showKeyState();
}
function keyStatus() {
  if (KEY_WHO.state === 'ok') return 'Connecté comme ' + KEY_WHO.player;
  if (KEY_WHO.state === 'refused') return 'Jeton refusé';
  if (KEY_WHO.state === 'none') return '';
  return 'Jeton enregistré, joueur pas encore vérifié';
}
function showKeyState() {
  const btn = document.getElementById('key-btn');
  const who = document.getElementById('key-who');
  if (btn) {
    btn.classList.toggle('on', KEY_WHO.state !== 'none' && KEY_WHO.state !== 'refused');
    btn.classList.toggle('refused', KEY_WHO.state === 'refused');
    btn.title = keyStatus() || KEY_TITLE;
  }
  if (who) who.textContent = KEY_WHO.state === 'ok' ? KEY_WHO.player
                           : KEY_WHO.state === 'refused' ? 'jeton refusé' : '';
}
function keyQuestion() {
  if (KEY_WHO.state === 'none') return 'Coller votre jeton de joueur (plm_…) :';
  if (KEY_WHO.state === 'refused') return 'Jeton refusé.\nColler un autre jeton, ou vider pour l\'oublier :';
  return keyStatus() + '.\nColler un nouveau jeton pour changer, ou vider pour l\'oublier :';
}
document.getElementById('key-btn').addEventListener('click', () => {
  const value = window.prompt(keyQuestion(), '');
  if (value === null) return;
  try {
    if (value.trim()) sessionStorage.setItem(TOKEN_KEY, value.trim());
    else sessionStorage.removeItem(TOKEN_KEY);
  } catch (_) { /* storage unavailable : the move will be refused (401) */ }
  checkToken();
});
checkToken();
