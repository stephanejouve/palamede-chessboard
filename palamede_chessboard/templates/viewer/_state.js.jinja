const params = new URLSearchParams(location.search);
const gameIdInput = document.getElementById('gameid');
const roleSelect = document.getElementById('role');
// The displayed game is explicit state (#46) : typing a search in the
// selector must not change which game the polls follow.
let CURRENT_GAME = (params.get('game') || '').trim();
gameIdInput.value = CURRENT_GAME;
roleSelect.value = params.get('viewer') || 'spectator';

let POS = [];
let idx = 0;
let lastResult = '*';
let COMMENTS = [];
let CLOCK = null;
let clockServerTs = 0;
let clockClientTs = 0;
let userPinned = false;

function gameId() { return CURRENT_GAME; }
function viewerRole() { return roleSelect.value; }
function qs(extra) { return '?game_id=' + encodeURIComponent(gameId()) + (extra ? '&' + extra : ''); }

// Board orientation : Black at the bottom for the black player. It follows
// the role (player_black → black) unless flipped by hand ; a manual flip is
// kept in the URL (``orient``) so that a shared link keeps it.
let ORIENT = ['white', 'black'].includes(params.get('orient')) ? params.get('orient') : '';
function boardOrientation() {
  if (ORIENT) return ORIENT;
  return viewerRole() === 'player_black' ? 'black' : 'white';
}
// No-op until the chessground module is up ; it reads boardOrientation()
// at creation, whichever script runs first.
function applyOrientation() {
  if (window.__cgSetOrientation) window.__cgSetOrientation(boardOrientation());
}

// The role follows the token's seat in the game shown (#337), read again at
// each game change : White, Black, or no seat. A player's role is never kept
// from the previous game ; a role chosen by hand that is not a seat (arbiter,
// post_mortem) stays as it is.
function seatRole(colors) {
  if (colors.length === 1) return 'player_' + colors[0];
  if (colors.length === 2) return viewerRole() === 'player_black' ? 'player_black' : 'player_white';
  return viewerRole().startsWith('player_') ? 'spectator' : viewerRole();
}
function applySeatRole(colors) {
  const role = seatRole(colors);
  if (role === viewerRole()) return;
  roleSelect.value = role;
  ORIENT = '';  // a new role resets the orientation to its own side
  updateUrl(); applyOrientation(); pollEngine();
}

roleSelect.addEventListener('change', () => {
  ORIENT = '';  // a new role resets the orientation to its own side
  updateUrl(); applyOrientation(); pollEngine();
});
document.getElementById('flip-btn').addEventListener('click', () => {
  ORIENT = boardOrientation() === 'white' ? 'black' : 'white';
  updateUrl(); applyOrientation();
});

// Player session (#351) : the token pasted with 🔑 goes once to
// /api/session, which answers with a browser token in an HttpOnly cookie,
// kept after the browser closes (owner, 14/11). The page never holds a
// token : the cookie goes with every request of this origin, and no script
// can read it. « Se déconnecter » asks the server to expire the cookie ;
// the token stays valid until revoked (owner, 14/11).
const OLD_TOKEN_KEY = 'palamede-player-token';  // sessionStorage, before #351
// Who the session is (#229) : asked to /api/me at load and after each
// change ; then the page's other parts hear « palamede-session ».
const KEY_TITLE = 'Jeton de joueur (pour jouer depuis le viewer)';
let KEY_WHO = { state: 'checking', player: '' };
function signedIn() { return KEY_WHO.state === 'ok'; }
let SESSION_CHECK = 0;
async function checkSession() {
  const mine = ++SESSION_CHECK;
  let next = { state: 'unknown', player: '' };
  try {
    const r = await fetch('/api/me', { cache: 'no-store' });
    if (r.ok) next = { state: 'ok', player: String((await r.json()).player || '') };
    else if (r.status === 401) next = { state: 'none', player: '' };
  } catch (_) { /* viewer unreachable : the player stays unknown */ }
  if (mine !== SESSION_CHECK) return;  // a newer check started meanwhile : it answers
  KEY_WHO = next;
  showKeyState();
  document.dispatchEvent(new Event('palamede-session'));
}
async function openSession(token) {
  let refused = true;
  try {
    const r = await fetch('/api/session', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token }),
    });
    refused = !r.ok;
  } catch (_) { /* unreachable : refused below, the previous session kept */ }
  await checkSession();
  // Refused while signed in : the session in place is kept, and said so.
  if (refused && KEY_WHO.state === 'ok') window.alert('Jeton refusé : toujours connecté comme ' + KEY_WHO.player + '.');
  else if (refused) { KEY_WHO = { state: 'refused', player: '' }; showKeyState(); }
}
async function closeSession() {
  try { await fetch('/api/session/logout', { method: 'POST' }); } catch (_) { /* checked below */ }
  await checkSession();
}
function keyStatus() {
  if (KEY_WHO.state === 'ok') return 'Connecté comme ' + KEY_WHO.player;
  if (KEY_WHO.state === 'refused') return 'Jeton refusé';
  if (KEY_WHO.state === 'unknown') return 'Session non vérifiée (viewer injoignable)';
  return '';
}
function showKeyState() {
  const btn = document.getElementById('key-btn');
  const who = document.getElementById('key-who');
  const out = document.getElementById('logout-btn');
  if (btn) {
    btn.classList.toggle('on', KEY_WHO.state === 'ok');
    btn.classList.toggle('refused', KEY_WHO.state === 'refused');
    btn.title = keyStatus() || KEY_TITLE;
  }
  if (who) who.textContent = KEY_WHO.state === 'ok' ? KEY_WHO.player
                           : KEY_WHO.state === 'refused' ? 'jeton refusé' : '';
  if (out) out.hidden = KEY_WHO.state !== 'ok';
  const up = document.getElementById('signup-btn');
  if (up) up.hidden = KEY_WHO.state !== 'none' && KEY_WHO.state !== 'refused';
}
function keyQuestion() {
  if (KEY_WHO.state === 'ok') return keyStatus() + '.\nColler un autre jeton pour changer de joueur :';
  if (KEY_WHO.state === 'refused') return 'Jeton refusé.\nColler un autre jeton de joueur (plm_…) :';
  return 'Coller votre jeton de joueur (plm_…) :';
}
document.getElementById('key-btn').addEventListener('click', () => {
  const value = window.prompt(keyQuestion(), '');
  if (value && value.trim()) openSession(value.trim());
});
document.getElementById('logout-btn').addEventListener('click', closeSession);
// Open sign-up (#351) : a name, then the recovery token, shown once and only
// if wanted ; the server signs the browser in with its cookie.
const RECOVERY_OFFER = 'Recevoir un jeton de récupération ?\n'
  + 'Il permet de retrouver votre compte si vous perdez ce navigateur. '
  + 'Il ne sera montré qu\'une fois : à garder comme un mot de passe.';
async function signUp() {
  const name = window.prompt('Votre nom de joueur (lettres a-z, chiffres, _ et -) :', '');
  if (!name || !name.trim()) return;
  const recovery = window.confirm(RECOVERY_OFFER);
  let answer = null, detail = 'viewer injoignable';
  try {
    const r = await fetch('/api/players', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ player_id: name.trim(), display_name: name.trim(), recovery }),
    });
    const body = await r.json().catch(() => ({}));
    if (r.ok) answer = body;
    else detail = typeof body.detail === 'string' ? body.detail : 'inscription refusée';
  } catch (_) { /* unreachable : said below */ }
  if (!answer) { window.alert('Inscription refusée : ' + detail + '.'); return; }
  if (answer.recovery) window.prompt('Jeton de récupération, à copier et garder (il ne sera plus montré) :', answer.recovery);
  await checkSession();
}
document.getElementById('signup-btn').addEventListener('click', signUp);
// A token left in sessionStorage by an older page is moved once to the
// cookie, then forgotten : the page holds none any more.
async function startSession() {
  let old = '';
  try {
    old = sessionStorage.getItem(OLD_TOKEN_KEY) || '';
    sessionStorage.removeItem(OLD_TOKEN_KEY);
  } catch (_) { /* storage refused : nothing to move */ }
  if (old) await openSession(old);
  else await checkSession();
}
startSession();
